<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- Bluetooth permissions for Android 12+ (API 31+) -->
    <!--
        neverForLocation (IP-140): this app does NOT derive position from scan
        results, and saying so is what releases BLE scanning from ACCESS_FINE_LOCATION
        on API 31+. Without the flag Android treats every scan result as
        location-derived and withholds callbacks unless fine location is held —
        which is why the app asked for a permission nothing here reads.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Bluetooth permissions for Android 11 and below -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!--
        No location permissions (2026-08-26). Every one of ACCESS_FINE_LOCATION,
        ACCESS_COARSE_LOCATION and ACCESS_BACKGROUND_LOCATION was removed: this app
        contains no code that reads a position, and the participant consent copy in
        every quest says so.

        BLE still works without them. Advertising uses BLUETOOTH_ADVERTISE, and
        scanning is released from the location requirement by neverForLocation on
        BLUETOOTH_SCAN above. Restoring any of these means restoring the consent
        text with it.
    -->

    <!-- Network state, so the datagram socket can be pinned to the experiment AP's network -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Lab session residency: foreground service + wake lock + its notification -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Declare Bluetooth feature -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Declare Camera feature -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <application
        android:name=".MonadApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:name">
        <!--
            launchMode=singleTask is load-bearing for deep links (IP-128). With the
            default `standard`, a VIEW intent delivered while the app is already
            running spawns a SECOND MainActivity with a brand-new Voyager stack
            instead of calling onNewIntent — so scanning a sticker mid-session
            would silently restart the app over the top of a running quest.
        -->
        <activity
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Android App Links for fleet device labels (IP-128).

                android:pathPrefix is NOT redundant with the server-side
                `dynamic_app_link_components` in assetlinks.json: those are Android
                15+ (API 35) only. Android 14 and earlier ignore them and fall back
                to THIS scope, so without the prefix an older phone with the app
                installed would capture every URL on monad.dubec.dev — the whole
                research site — and then fail to route most of them.

                Verification requires assetlinks.json to carry the SHA-256 of the
                certificate the installed build was signed with. Debug-signed
                builds will NOT verify against a Play App Signing fingerprint;
                check with `adb shell pm get-app-links sk.martinvanco.monad`.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="monad.dubec.dev"
                    android:pathPrefix="/d/" />
                <!--
                    IP-140 — lab marker cards. A second <data> rather than a second
                    intent-filter: one filter with two prefixes claims exactly those
                    two paths, while a second filter would repeat the host and the
                    autoVerify and give two places for the scope to drift apart.
                -->
                <data
                    android:scheme="https"
                    android:host="monad.dubec.dev"
                    android:pathPrefix="/m/" />
            </intent-filter>
        </activity>

        <!-- Keeps a lab session alive with the screen off. Holds no measurement logic. -->
        <service
            android:name=".lab.service.LabSessionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
