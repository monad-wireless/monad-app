-- AppSettings table for key-value storage of app preferences
CREATE TABLE IF NOT EXISTS AppSettings (
    key TEXT PRIMARY KEY NOT NULL,
    value TEXT NOT NULL
);

-- Queries
selectAll:
SELECT * FROM AppSettings;

selectByKey:
SELECT value FROM AppSettings
WHERE key = ?;

insertOrReplace:
INSERT OR REPLACE INTO AppSettings(key, value)
VALUES (?, ?);

deleteByKey:
DELETE FROM AppSettings
WHERE key = ?;

deleteAll:
DELETE FROM AppSettings;
