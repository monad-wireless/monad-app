-- Per-session sample streams. Deliberately three narrow tables rather than one wide one: the
-- traffic stream is high-rate (hundreds of rows per second) and must not carry beacon columns.

CREATE TABLE IF NOT EXISTS TrafficSampleRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    sequence INTEGER NOT NULL,
    sentMonoNs INTEGER NOT NULL,
    latenessNs INTEGER NOT NULL,
    sizeBytes INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_traffic_session ON TrafficSampleRecord(sessionId);

CREATE TABLE IF NOT EXISTS BeaconObservationRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    uuid TEXT NOT NULL,
    major INTEGER NOT NULL,
    minor INTEGER NOT NULL,
    rssi INTEGER NOT NULL,
    txPower INTEGER,
    proximity TEXT,
    accuracyM REAL,
    monoNs INTEGER NOT NULL,
    wallMs INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_beacon_session ON BeaconObservationRecord(sessionId);

CREATE TABLE IF NOT EXISTS ZoneTransitionRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    major INTEGER NOT NULL,
    minor INTEGER NOT NULL,
    cellId TEXT,
    label TEXT,
    entered INTEGER NOT NULL,
    monoNs INTEGER NOT NULL,
    wallMs INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_transition_session ON ZoneTransitionRecord(sessionId);

CREATE TABLE IF NOT EXISTS ClockSampleRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    monoNs INTEGER NOT NULL,
    offsetNs INTEGER NOT NULL,
    rttNs INTEGER NOT NULL,
    skewPpm REAL NOT NULL,
    samples INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_clock_session ON ClockSampleRecord(sessionId);


-- Pose track: where the phone was, sampled.
--
-- The stream a fingerprinting walk exists to produce. Every other table here records what the radio
-- did; this one records where the handset was while it did it, in a session-local frame whose origin
-- is wherever tracking started. `quality` is not decoration: visual-inertial odometry keeps
-- returning a plausible position while it is lost, so a track without a per-sample trust column has
-- bad segments that are indistinguishable from good ones.
--
-- Narrow and numeric, like the traffic table and for the same reason: a ten-minute walk at 10 Hz is
-- six thousand rows, and a walk at the camera's frame rate would be sixty times that.
CREATE TABLE IF NOT EXISTS PoseSampleRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    monoNs INTEGER NOT NULL,
    wallMs INTEGER NOT NULL,
    x REAL NOT NULL,
    y REAL NOT NULL,
    z REAL NOT NULL,
    qx REAL NOT NULL,
    qy REAL NOT NULL,
    qz REAL NOT NULL,
    qw REAL NOT NULL,
    quality TEXT NOT NULL,
    reason TEXT
);

CREATE INDEX IF NOT EXISTS idx_pose_session ON PoseSampleRecord(sessionId, monoNs);


-- Mesh change log: when the room's geometry became what the exported mesh contains.
--
-- A change log, not a periodic dump. ARKit publishes no timestamps and no revision counter — an
-- anchor's geometry simply becomes a different object — so a change has to be detected and written
-- down, and logging every block on every tick would bury the handful of rows that say something
-- happened under thousands of identical ones.
--
-- What this answers, and nothing else can: a block refined late in a walk is fine, a block that
-- changed AFTER the walk had already passed it means the room moved, and the exported mesh is then
-- only valid for the window after that change.
CREATE TABLE IF NOT EXISTS MeshObservationRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    monoNs INTEGER NOT NULL,
    wallMs INTEGER NOT NULL,
    anchorId TEXT NOT NULL,
    revision INTEGER NOT NULL,
    vertices INTEGER NOT NULL,
    faces INTEGER NOT NULL,
    classified INTEGER NOT NULL,
    x REAL NOT NULL,
    y REAL NOT NULL,
    z REAL NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_mesh_session ON MeshObservationRecord(sessionId, monoNs);

-- Binary artefacts that are not sample streams.
--
-- The mesh is the first, and the gap it fills is older than the mesh: `SensorCapture` has carried an
-- optional `payload: ByteArray` since the sensor modules were written and there has never been
-- anywhere to put it, so a room scan or a UWB range log had no path off the device.
--
-- Persisted rather than held in memory and uploaded at close, because the house rule is
-- upload-then-delete: an artefact that exists only in the process is lost the first time an upload
-- fails, and a failed upload is the normal case on an experiment network.
--
-- UNIQUE on (sessionId, name) with INSERT OR REPLACE, so re-exporting supersedes rather than
-- duplicating. Two meshes under one name would make the uploaded prefix depend on row order.
CREATE TABLE IF NOT EXISTS SessionBlobRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    name TEXT NOT NULL,
    contentType TEXT NOT NULL,
    monoNs INTEGER NOT NULL,
    wallMs INTEGER NOT NULL,
    bytes BLOB NOT NULL,
    sizeBytes INTEGER NOT NULL
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_blob_session_name ON SessionBlobRecord(sessionId, name);


-- Markers: what the participant was being asked to do, stamped onto the same timeline as the
-- samples. The instrument records one continuous session; a marker says "from here, this window
-- is occupancy 3, arrangement o3-a". That keeps the radio warm across takes (no restart gaps) and
-- survives a UI crash: the stream continues, the markers simply stop.
CREATE TABLE IF NOT EXISTS SessionMarkerRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    kind TEXT NOT NULL,
    stepId TEXT,
    label TEXT NOT NULL,
    payload TEXT,
    monoNs INTEGER NOT NULL,
    wallMs INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS idx_marker_session ON SessionMarkerRecord(sessionId);

-- Health checkpoints: liveness, periodically written down.
--
-- Health was in memory only, so a session the OS killed produced a recovered sidecar that could
-- reconstruct row counts and nothing else. "Was it degraded for 42 minutes?" — the question the
-- whole health module exists to answer — was unanswerable for exactly the sessions most likely to
-- have gone wrong, because a crashed session is not a random sample of sessions.
--
-- One row per stream per checkpoint, written off the same 1 Hz heartbeat that already polls the
-- counters (throttled to one checkpoint per 30 s). Nothing here touches the emission path: the
-- heartbeat reads counters the instrument already maintains, and this write happens on the
-- heartbeat's own coroutine.
CREATE TABLE IF NOT EXISTS SessionHealthCheckpointRecord (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    sessionId TEXT NOT NULL,
    monoNs INTEGER NOT NULL,
    wallMs INTEGER NOT NULL,
    stream TEXT NOT NULL,
    state TEXT NOT NULL,
    worst TEXT NOT NULL,
    events INTEGER NOT NULL,
    eventsPerSecond REAL NOT NULL,
    expectedRateHz REAL,
    silenceMs INTEGER NOT NULL,
    degradedMs INTEGER NOT NULL,
    staleMs INTEGER NOT NULL,
    deadMs INTEGER NOT NULL,
    clockGateStatus TEXT NOT NULL,
    clockSamples INTEGER NOT NULL,
    clockResidualMs REAL
);

CREATE INDEX IF NOT EXISTS idx_health_session ON SessionHealthCheckpointRecord(sessionId, monoNs);

-- Traffic
insertTrafficSample:
INSERT INTO TrafficSampleRecord(sessionId, sequence, sentMonoNs, latenessNs, sizeBytes)
VALUES (?, ?, ?, ?, ?);

selectTrafficBySession:
SELECT * FROM TrafficSampleRecord WHERE sessionId = ? ORDER BY sequence ASC;

countTrafficBySession:
SELECT COUNT(*) FROM TrafficSampleRecord WHERE sessionId = ?;

deleteTrafficBySession:
DELETE FROM TrafficSampleRecord WHERE sessionId = ?;

-- Beacons
insertBeaconObservation:
INSERT INTO BeaconObservationRecord(sessionId, uuid, major, minor, rssi, txPower, proximity, accuracyM, monoNs, wallMs)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectBeaconsBySession:
SELECT * FROM BeaconObservationRecord WHERE sessionId = ? ORDER BY monoNs ASC;

countBeaconsBySession:
SELECT COUNT(*) FROM BeaconObservationRecord WHERE sessionId = ?;

deleteBeaconsBySession:
DELETE FROM BeaconObservationRecord WHERE sessionId = ?;

-- Transitions
insertZoneTransition:
INSERT INTO ZoneTransitionRecord(sessionId, major, minor, cellId, label, entered, monoNs, wallMs)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectTransitionsBySession:
SELECT * FROM ZoneTransitionRecord WHERE sessionId = ? ORDER BY monoNs ASC;

countTransitionsBySession:
SELECT COUNT(*) FROM ZoneTransitionRecord WHERE sessionId = ?;

deleteTransitionsBySession:
DELETE FROM ZoneTransitionRecord WHERE sessionId = ?;

-- Clock
insertClockSample:
INSERT INTO ClockSampleRecord(sessionId, monoNs, offsetNs, rttNs, skewPpm, samples)
VALUES (?, ?, ?, ?, ?, ?);

selectClockBySession:
SELECT * FROM ClockSampleRecord WHERE sessionId = ? ORDER BY monoNs ASC;

countClockBySession:
SELECT COUNT(*) FROM ClockSampleRecord WHERE sessionId = ?;

deleteClockBySession:
DELETE FROM ClockSampleRecord WHERE sessionId = ?;

-- Markers
insertMarker:
INSERT INTO SessionMarkerRecord(sessionId, kind, stepId, label, payload, monoNs, wallMs)
VALUES (?, ?, ?, ?, ?, ?, ?);

markersForSession:
SELECT * FROM SessionMarkerRecord WHERE sessionId = ? ORDER BY monoNs ASC;

countMarkersBySession:
SELECT COUNT(*) FROM SessionMarkerRecord WHERE sessionId = ?;

countBlockMarkersBySession:
SELECT COUNT(*) FROM SessionMarkerRecord
WHERE sessionId = ? AND kind IN ('block_start', 'block_stop');

countWaypointMarkersBySession:
SELECT COUNT(*) FROM SessionMarkerRecord WHERE sessionId = ? AND kind = 'waypoint';

deleteMarkersForSession:
DELETE FROM SessionMarkerRecord WHERE sessionId = ?;

-- Health checkpoints
insertHealthCheckpoint:
INSERT INTO SessionHealthCheckpointRecord(
    sessionId, monoNs, wallMs, stream, state, worst, events, eventsPerSecond, expectedRateHz,
    silenceMs, degradedMs, staleMs, deadMs, clockGateStatus, clockSamples, clockResidualMs
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectHealthBySession:
SELECT * FROM SessionHealthCheckpointRecord WHERE sessionId = ? ORDER BY monoNs ASC, id ASC;

-- The newest checkpoint, whole. Recovery reads this and nothing else: the last row per stream is
-- the furthest the session got, and its time-in-state counters are cumulative, so one checkpoint
-- carries the entire history the in-memory tracker had at that instant.
selectLastHealthCheckpoint:
SELECT * FROM SessionHealthCheckpointRecord
WHERE sessionId = ?
  AND monoNs = (SELECT MAX(monoNs) FROM SessionHealthCheckpointRecord WHERE sessionId = ?)
ORDER BY id ASC;

countHealthBySession:
SELECT COUNT(*) FROM SessionHealthCheckpointRecord WHERE sessionId = ?;

deleteHealthBySession:
DELETE FROM SessionHealthCheckpointRecord WHERE sessionId = ?;

-- Pose
insertPoseSample:
INSERT INTO PoseSampleRecord(sessionId, monoNs, wallMs, x, y, z, qx, qy, qz, qw, quality, reason)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectPoseBySession:
SELECT * FROM PoseSampleRecord WHERE sessionId = ? ORDER BY monoNs ASC, id ASC;

countPoseBySession:
SELECT COUNT(*) FROM PoseSampleRecord WHERE sessionId = ?;

-- Fraction of the track the platform trusted, without materialising the rows. A walk that came back
-- at 12 % normal is a walk whose geometry has to be re-taken, and the sidecar has to be able to say
-- so for a session the OS killed as well as for one that reached stop().
countPoseNormalBySession:
SELECT COUNT(*) FROM PoseSampleRecord WHERE sessionId = ? AND quality = 'normal';

deletePoseBySession:
DELETE FROM PoseSampleRecord WHERE sessionId = ?;

-- Mesh observations
insertMeshObservation:
INSERT INTO MeshObservationRecord(
    sessionId, monoNs, wallMs, anchorId, revision, vertices, faces, classified, x, y, z
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMeshBySession:
SELECT * FROM MeshObservationRecord WHERE sessionId = ? ORDER BY monoNs ASC, id ASC;

countMeshBySession:
SELECT COUNT(*) FROM MeshObservationRecord WHERE sessionId = ?;

-- Distinct blocks ever seen, and the window they were seen in. Enough for the sidecar without
-- materialising the log.
meshSpanBySession:
SELECT COUNT(DISTINCT anchorId) AS anchors, MIN(monoNs) AS firstMonoNs, MAX(monoNs) AS lastMonoNs
FROM MeshObservationRecord WHERE sessionId = ?;

deleteMeshBySession:
DELETE FROM MeshObservationRecord WHERE sessionId = ?;

-- Binary artefacts
insertBlob:
INSERT OR REPLACE INTO SessionBlobRecord(sessionId, name, contentType, monoNs, wallMs, bytes, sizeBytes)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Metadata only. Selecting `bytes` to list what is pending would load every mesh on the device into
-- memory to print a row count.
selectBlobMetaBySession:
SELECT name, contentType, monoNs, wallMs, sizeBytes FROM SessionBlobRecord
WHERE sessionId = ? ORDER BY name ASC;

selectBlobBytes:
SELECT bytes FROM SessionBlobRecord WHERE sessionId = ? AND name = ?;

countBlobsBySession:
SELECT COUNT(*) FROM SessionBlobRecord WHERE sessionId = ?;

blobBytesBySession:
SELECT COALESCE(SUM(sizeBytes), 0) FROM SessionBlobRecord WHERE sessionId = ?;

deleteBlobsBySession:
DELETE FROM SessionBlobRecord WHERE sessionId = ?;
