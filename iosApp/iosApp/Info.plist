<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Monad Scan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Monad Scan</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth is used to find lab beacons and, during a measurement walk you start yourself, to broadcast an anonymous session code the lab sensors can hear.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Bluetooth is used to find lab beacons and, during a measurement walk you start yourself, to broadcast an anonymous session code the lab sensors can hear.</string>
	<key>NSCameraUsageDescription</key>
	<string>This app requires camera access to scan QR codes.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app sends UDP packets to devices on your local network for research data collection.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Always access is required so the app can record which zone you are in while it is in your pocket. "When In Use" is revoked the moment the app is backgrounded, which is when a lab session actually runs.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Always access is required so the app can record which zone you are in while it is in your pocket.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app uses your location to enable location-based quest features and Bluetooth scanning.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
		<!-- Keeps CBPeripheralManager alive across a brief app switch. It does NOT make the
		     broadcast readable from the background: iOS moves the service UUID into its overflow
		     area there, which the fleet's raw scanner cannot see — see IdentityBroadcaster.ios.kt. -->
		<string>bluetooth-peripheral</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>bluetooth-le</string>
		<string>location-services</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
