<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Monad Scan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Monad Scan</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>dev.dubec.monad.checkin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>monad</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!--
	    Crash reporting is ON by default and the participant can opt out. Stated here so the default
	    is a fact of the build rather than a line of Kotlin somebody has to find, and so it cannot
	    silently disagree with the Android manifest's matching meta-data.

	    `App.kt` re-asserts the answer at every launch, which is what clears the persisted `false`
	    left by the build that switched collection off at every start. See `CrashContext`.
	-->
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Bluetooth is used to find lab beacons and, during a measurement walk you start yourself, to broadcast an anonymous session code the lab sensors can hear.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Bluetooth is used to find lab beacons and, during a measurement walk you start yourself, to broadcast an anonymous session code the lab sensors can hear.</string>
	<key>NSCameraUsageDescription</key>
	<string>The camera reads the printed codes on lab markers, and during a measurement walk you start yourself it also tracks the phone's own movement through the room so the recording knows where it was. No photographs or video are saved.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>This app sends UDP packets to devices on your local network for research data collection.</string>
	<!--
	    ITMS-90683, the BLOCKING one on build 6 (2026-09-19).

	    The app never starts a Nearby Interaction session. It calls `NISession.isSupported()` in two
	    places — `HandsetDescriptor.ios.kt` and `SensorModules.ios.kt` — to record whether this
	    handset has a U1/U2 chip, because a walk's odometry quality depends on which iPhone recorded
	    it. Apple's validator demands a purpose string for the REFERENCE, not for a call that asks
	    for permission, so no prompt will ever show this sentence. It is written to be true anyway,
	    in case the ranging half is ever built.

	    TWO LOCATION STRINGS ARE ABSENT BECAUSE THE CODE THAT ASKED FOR THEM IS GONE.
	    `NSLocationWhenInUseUsageDescription` and `NSLocationAlwaysAndWhenInUseUsageDescription` were
	    warned about on builds 6 and 7, both times because of ONE line:
	    `CLLocationManager.headingAvailable()` in `HandsetDescriptor.ios.kt`, a static magnetometer
	    check that asks the user for nothing. Writing those strings would have this file contradict
	    the consent copy, which promises no location of any kind, so the reference was deleted
	    instead. `magnetometer` from CoreMotion is the same physical fact and needs no string.

	    iOS location was removed with the beacon witness on 2026-08-26 (`BeaconWitness.ios.kt` has the
	    reasoning and the cost). Restoring iOS beacon witnessing (Phase 5) brings all of it back
	    together: the Always permission, the `location` background mode, both strings, the
	    `headingAvailable` probe, and an edit to the consent copy. One deliberate decision, not five
	    drifted settings.
	-->
	<key>NSNearbyInteractionUsageDescription</key>
	<string>MonadCount records whether this iPhone supports ultra-wideband ranging, as one line of the device description saved with a measurement session. The app does not range to other devices.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>bluetooth-le</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
