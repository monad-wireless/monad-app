<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  IP-128 — Universal Links for fleet device labels (https://monad.dubec.dev/d/*),
	  extended by IP-140 to lab marker cards (https://monad.dubec.dev/m/*).

	  Nothing here names either path, and that is correct: the entitlement claims the
	  DOMAIN, and which paths within it open the app is decided by the AASA file the
	  server publishes. `web.applinks.claimed_path` has listed both `/d/*` and `/m/*`
	  since IP-129, so the iOS side of the marker claim needed no change — only the
	  handset's parser, which until IP-140 rejected `/m/` and left the claim dangling.
	  Android is the opposite: its manifest must repeat the prefixes, because Android
	  14 and earlier ignore the server's dynamic components entirely.

	  Paid-team entitlement, like HotspotConfiguration above: the free-personal-team
	  build path signs iosApp-personal.entitlements (an intentionally empty dict) and
	  therefore has NO Universal Links. On a personal build a scanned sticker opens
	  Safari instead — correct behaviour, and the reason the web page must stand on
	  its own rather than being a stub that says "open the app".

	  The claim only takes effect once monad.dubec.dev serves
	  /.well-known/apple-app-site-association listing this build's <TEAMID>.<bundle-id>.
	  Since iOS 14 the file is fetched by an Apple-managed CDN, not by the device, so
	  a change can take up to 24h to be picked up and installed apps re-check roughly
	  weekly. Append ?mode=developer while bringing this up.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:monad.dubec.dev</string>
	</array>
</dict>
</plist>
